VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values used by Vercel functions. Never prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin used for Stripe return URLs, for example https://sbloccoinglese.com
PUBLIC_SITE_URL=

# Stripe server secrets. Use test-mode values locally and configure production values only in Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# An offer is purchasable only when both its PRICE and ACCESS values are configured.
# ACCESS must identify a real existing resource. ACCESS_URL is the authenticated route opened after purchase.
STRIPE_PRICE_COLLOQUIO_ESSENTIAL=
STRIPE_ACCESS_COLLOQUIO_ESSENTIAL=
STRIPE_ACCESS_URL_COLLOQUIO_ESSENTIAL=
STRIPE_PRICE_COLLOQUIO_COMPLETE=
STRIPE_ACCESS_COLLOQUIO_COMPLETE=
STRIPE_ACCESS_URL_COLLOQUIO_COMPLETE=
STRIPE_PRICE_COLLOQUIO_COMPLETE_PLUS=
STRIPE_ACCESS_COLLOQUIO_COMPLETE_PLUS=
STRIPE_ACCESS_URL_COLLOQUIO_COMPLETE_PLUS=

# Optional public Stripe Payment Links for the Interview storefront.
# They are safe to expose in the browser. If omitted, the three digital offers use the authenticated
# server-side Checkout configuration above. Inactive role packs never render a dead purchase button.
# Configure each Payment Link in Stripe with static Checkout Session metadata offer_id=<matching offer id>.
# Keep the corresponding server-only ACCESS value populated so the signed webhook can grant access.
# Set the Payment Link completion redirect to /checkout/success?session_id={CHECKOUT_SESSION_ID}.
VITE_STRIPE_INTERVIEW_KIT_URL=
VITE_STRIPE_INTERVIEW_CORE_URL=
VITE_STRIPE_INTERVIEW_COMPLETE_URL=
VITE_STRIPE_INTERVIEW_LAB_URL=
VITE_STRIPE_INTERVIEW_TECH_URL=
VITE_STRIPE_INTERVIEW_MARKETING_URL=
VITE_STRIPE_INTERVIEW_SALES_URL=
VITE_STRIPE_INTERVIEW_FINANCE_URL=
VITE_STRIPE_INTERVIEW_HOSPITALITY_URL=
VITE_STRIPE_INTERVIEW_GRADUATE_URL=

STRIPE_PRICE_LAVORARE_ESSENTIAL=
STRIPE_ACCESS_LAVORARE_ESSENTIAL=
STRIPE_ACCESS_URL_LAVORARE_ESSENTIAL=
STRIPE_PRICE_LAVORARE_COMPLETE=
STRIPE_ACCESS_LAVORARE_COMPLETE=
STRIPE_ACCESS_URL_LAVORARE_COMPLETE=

STRIPE_PRICE_PARLARE_ESSENTIAL=
STRIPE_ACCESS_PARLARE_ESSENTIAL=
STRIPE_ACCESS_URL_PARLARE_ESSENTIAL=
STRIPE_PRICE_PARLARE_COMPLETE=
STRIPE_ACCESS_PARLARE_COMPLETE=
STRIPE_ACCESS_URL_PARLARE_COMPLETE=

STRIPE_PRICE_ESTERO_ESSENTIAL=
STRIPE_ACCESS_ESTERO_ESSENTIAL=
STRIPE_ACCESS_URL_ESTERO_ESSENTIAL=
STRIPE_PRICE_ESTERO_COMPLETE=
STRIPE_ACCESS_ESTERO_COMPLETE=
STRIPE_ACCESS_URL_ESTERO_COMPLETE=

STRIPE_PRICE_BASI_ESSENTIAL=
STRIPE_ACCESS_BASI_ESSENTIAL=
STRIPE_ACCESS_URL_BASI_ESSENTIAL=
STRIPE_PRICE_BASI_COMPLETE=
STRIPE_ACCESS_BASI_COMPLETE=
STRIPE_ACCESS_URL_BASI_COMPLETE=

# Recupero Debito Inglese — one-time digital pathway.
STRIPE_PRICE_RECUPERO_DEBITO=
STRIPE_ACCESS_RECUPERO_DEBITO=recupero-debito
STRIPE_ACCESS_URL_RECUPERO_DEBITO=/recupero-debito/onboarding
