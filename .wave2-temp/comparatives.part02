lient_key":"recovery_comp_recover_4","type":"multiple_choice","title":"Qualità irregolare","prompt":"I slept eight hours last night and only four hours the night before. I feel ___ today.","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"irregular","primary_skill":"grammar","learning_objective":"Use better as the irregular comparative of good in context","difficulty":"support","content":{"options":[{"key":"a","text":"better","is_correct":true},{"key":"b","text":"more good","is_correct":false,"error_code":"COMPARATIVE_IRREGULAR"},{"key":"c","text":"gooder","is_correct":false,"error_code":"COMPARATIVE_IRREGULAR"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Good non segue la regola regolare: good → better."},"diagnostics":{"tested_codes":["COMPARATIVE_IRREGULAR"],"fallback_error_code":"COMPARATIVE_IRREGULAR"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_recover_5","type":"error_correction","title":"Sistema il confronto","prompt":"Correggi: This café is more cheaper than the one near school.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"double_comparative","primary_skill":"grammar","learning_objective":"Remove a double comparative while preserving the comparison","difficulty":"support","content":{"accepted_answers":["This café is cheaper than the one near school.","This cafe is cheaper than the one near school."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Cheaper è già comparativo: non aggiungere more."},"diagnostics":{"tested_codes":["COMPARATIVE_ER","COMPARATIVE_THAN"],"fallback_error_code":"COMPARATIVE_ER"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_recover_6","type":"translation","title":"Un confronto completo","prompt":"Questa giacca è più comoda di quella blu.","instructions":"Traduci in inglese.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"integrated","primary_skill":"grammar","learning_objective":"Produce a long-adjective comparative with than in a familiar shopping context","difficulty":"support","content":{"accepted_answers":["This jacket is more comfortable than the blue one.","This jacket is more comfortable than the blue jacket.","This coat is more comfortable than the blue one."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Comfortable usa more; il secondo termine è introdotto da than."},"diagnostics":{"tested_codes":["COMPARATIVE_MORE","COMPARATIVE_THAN"],"fallback_error_code":"COMPARATIVE_MORE"},"tags":["recovery","comparatives"],"foundation_links":[]}],"question_refs":[],"pool_rules":[]}],"tags":["recovery","comparatives","recover","wave-2"],"foundation_links":[]},{"client_key":"recovery_comparatives_practice","title":"Comparatives — Allenati","description":"Pratica comparativi in decisioni, acquisti, trasporti e vita scolastica.","instructions":"Scegli la forma dal significato e produci confronti completi.","instruction_language":"it","level":"A1+","topic":"comparatives","estimated_minutes":12,"settings":{"display_mode":"one_at_a_time","feedback_timing":"question_end","show_score":true,"show_correct_answers":true,"show_explanations":true,"show_diagnostic_summary":true,"allow_retry":true},"sections":[{"client_key":"recovery_comparatives_practice_section","title":"Allenati","instructions":"Scegli la forma dal significato e produci confronti completi.","selection_mode":"fixed","feedback_timing":"question_end","questions":[{"client_key":"recovery_comp_practice_1","type":"select_gap","title":"Scegli tra due alternative","prompt":"Completa il messaggio.","instructions":"Completa scegliendo la forma corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"form_choice","primary_skill":"grammar","learning_objective":"Choose -er or more from common adjective forms in one decision context","difficulty":"standard","content":{"text_template":"I checked both hostels. The one near the station is [[blank_1]], but the one by the park is [[blank_2]].","blanks":[{"key":"blank_1","accepted_answers":["cheaper"],"options":["cheaper","more cheap","cheapier"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"more cheap","error_code":"COMPARATIVE_ER"},{"answer":"cheapier","error_code":"COMPARATIVE_ER"}]},{"key":"blank_2","accepted_answers":["more comfortable"],"options":["more comfortable","comfortabler","more comfortabler"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"comfortabler","error_code":"COMPARATIVE_MORE"},{"answer":"more comfortabler","error_code":"COMPARATIVE_MORE"}]}]},"grading":{"mode":"per_blank","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Cheap → cheaper; comfortable → more comfortable."},"diagnostics":{"tested_codes":["COMPARATIVE_ER","COMPARATIVE_MORE"],"fallback_error_code":"COMPARATIVE_ER"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_practice_2","type":"dialogue_choice","title":"Quale telefono?","prompt":"Leo wants Phone B because its battery lasts longer. Which sentence fits?","instructions":"Leggi il dialogo e scegli la risposta più naturale.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"meaning","primary_skill":"interaction","learning_objective":"Interpret a two-option context and express a meaningful comparison","difficulty":"standard","content":{"scenario":"Two friends are choosing between two phones.","response_prompt":"Leo wants Phone B because its battery lasts longer. Which sentence fits?","turns":[{"key":"turn_1","speaker":"Maya","text":"Phone A has a larger screen, but it costs €80 more."},{"key":"turn_2","speaker":"Leo","text":"I travel a lot, so battery life matters more to me."}],"options":[{"key":"a","text":"Phone B is better for Leo than Phone A.","is_correct":true},{"key":"b","text":"Phone B is more good for Leo then Phone A.","is_correct":false,"error_code":"COMPARATIVE_IRREGULAR"},{"key":"c","text":"Phone B is the best than Phone A.","is_correct":false,"error_code":"COMPARATIVE_IRREGULAR"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Per due telefoni usiamo un comparativo: better ... than."},"diagnostics":{"tested_codes":["COMPARATIVE_IRREGULAR","COMPARATIVE_THAN"],"fallback_error_code":"COMPARATIVE_IRREGULAR"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_practice_3","type":"word_order","title":"Ordina il confronto","prompt":"La biblioteca nuova è più tranquilla della vecchia.","instructions":"Metti le parti nell'ordine corretto.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"than","primary_skill":"word_order","learning_objective":"Build a complete comparative clause with than","difficulty":"standard","content":{"tokens":["The new library","is","quieter","than","the old one"],"correct_order":["The new library","is","quieter","than","the old one"],"terminal_punctuation":"."},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Il nucleo è quieter than."},"diagnostics":{"tested_codes":["COMPARATIVE_ER","COMPARATIVE_THAN"],"fallback_error_code":"COMPARATIVE_ER"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_practice_4","type":"error_correction","title":"Una grafia da correggere","prompt":"Correggi: My little brother is happyer at his new school.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"spelling_y","primary_skill":"grammar","learning_objective":"Correct the y-to-ier comparative spelling","difficulty":"standard","content":{"accepted_answ