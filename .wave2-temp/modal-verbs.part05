hibition-like can not from context","difficulty":"challenge","content":{"accepted_answers":["You don't have to book, but you can't enter after ten.","You do not have to book, but you cannot enter after ten.","You don't have to make a reservation, but you can't enter after ten.","You do not have to make a reservation, but you cannot enter after ten."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION","A1_CAN_ABILITY_REQUESTS"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_verify_11","type":"multiple_choice","title":"Quale frase comunica il significato giusto?","prompt":"A school email says: “Bringing a tablet is optional. Phones are forbidden during the test.”","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"integrated_contrast","primary_skill":"grammar","learning_objective":"Integrate optional and forbidden meanings in one school context","difficulty":"challenge","content":{"options":[{"key":"a","text":"You don't have to bring a tablet, and you mustn't use a phone during the test.","is_correct":true},{"key":"b","text":"You mustn't bring a tablet, and you don't have to use a phone during the test.","is_correct":false,"error_code":"MODALS_OBLIGATION_PROHIBITION"},{"key":"c","text":"You should bring a tablet, and you can use a phone during the test.","is_correct":false,"error_code":"A2_MODALS_OBLIGATION_ADVICE"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION","A2_MODALS_OBLIGATION_ADVICE"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]}],"question_refs":[],"pool_rules":[]}],"tags":["recovery","modal-verbs","verify","wave-2"],"foundation_links":[]}]}