ion_mode":"fixed","feedback_timing":"exercise_end","questions":[{"client_key":"recovery_modals_verify_1","type":"multiple_choice","title":"Una capacità","prompt":"Which sentence is correct for a person who knows how to drive?","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"ability","primary_skill":"grammar","learning_objective":"Use can + base verb for ability","difficulty":"standard","content":{"options":[{"key":"a","text":"She can drive.","is_correct":true},{"key":"b","text":"She cans drive.","is_correct":false,"error_code":"A1_CAN_ABILITY_REQUESTS"},{"key":"c","text":"She can to drive.","is_correct":false,"error_code":"A1_CAN_ABILITY_REQUESTS"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["A1_CAN_ABILITY_REQUESTS","CORE_CAN"],"fallback_error_code":"A1_CAN_ABILITY_REQUESTS"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_verify_2","type":"error_correction","title":"Rivedi la frase","prompt":"Correggi: You must to show your ticket before boarding.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"modal_base","primary_skill":"grammar","learning_objective":"Remove to after must in an obligation","difficulty":"standard","content":{"accepted_answers":["You must show your ticket before boarding."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_verify_3","type":"select_gap","title":"Due regole diverse","prompt":"Completa.","instructions":"Completa scegliendo la forma corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"obligation_no_obli