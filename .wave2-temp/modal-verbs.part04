ructions":"Leggi il dialogo e scegli la risposta più naturale.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"prohibition","primary_skill":"interaction","learning_objective":"Infer a prohibition from a connected information dialogue","difficulty":"standard","content":{"scenario":"Two friends read the event email.","response_prompt":"What can Maya correctly say about glass bottles?","turns":[{"key":"turn_1","speaker":"Maya","text":"It says “No glass bottles”."},{"key":"turn_2","speaker":"Leo","text":"Okay. What about plastic water bottles?"},{"key":"turn_3","speaker":"Maya","text":"It says water is available inside, but visitors may bring their own plastic bottle."}],"options":[{"key":"a","text":"You mustn't bring a glass bottle.","is_correct":true},{"key":"b","text":"You don't have to bring a glass bottle.","is_correct":false,"error_code":"MODALS_OBLIGATION_PROHIBITION"},{"key":"c","text":"You should bring a glass bottle.","is_correct":false,"error_code":"A2_MODALS_OBLIGATION_ADVICE"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_verify_6","type":"word_order","title":"Forma la domanda","prompt":"Metti in ordine.","instructions":"Metti le parti nell'ordine corretto.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"have_to_question","primary_skill":"word_order","learning_objective":"Build a present-simple question with have to","difficulty":"standard","content":{"tokens":["Does","Marco","have to","work","on Saturday"],"correct_order":["Does","Marco","have to","work","on Saturday"],"terminal_punctuation":"?"},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION"],"fallback