ons":["has to","have to","musts"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"have to","error_code":"MODALS_OBLIGATION_PROHIBITION"},{"answer":"musts","error_code":"MODALS_OBLIGATION_PROHIBITION"}]},{"key":"blank_2","accepted_answers":["doesn't have to","does not have to"],"options":["doesn't have to","mustn't","doesn't has to"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"mustn't","error_code":"MODALS_OBLIGATION_PROHIBITION"},{"answer":"doesn't has to","error_code":"MODALS_OBLIGATION_PROHIBITION"}]}]},"grading":{"mode":"per_blank","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"She has to...; nella negativa: she doesn't have to..."},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_recover_6","type":"translation","title":"Un consiglio","prompt":"Dovresti dormire di più prima degli esami.","instructions":"Traduci in inglese.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"advice","primary_skill":"grammar","learning_objective":"Produce should + base verb for advice","difficulty":"support","content":{"accepted_answers":["You should sleep more before exams.","You should get more sleep before exams.","You should sleep more before the exams."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Should dà un consiglio e prende il verbo base."},"diagnostics":{"tested_codes":["A2_MODALS_OBLIGATION_ADVICE"],"fallback_error_code":"A2_MODALS_OBLIGATION_ADVICE"},"tags":["recovery","modal-verbs"],"foundation_links":[]}],"question_refs":[],"pool_rules":[]}],"tags":["recovery","modal-verbs","recover","wave-2"],"foundation_links":[]},{"client_key":"recovery_modal_verbs_practice","title":"Modal Verbs — Allenati","description":"Pratica modali in regole, permessi, lavoro, scuola e consigli.","instructions":"Interpreta il significato prima di scegliere la struttura.","instruction_language":"it","level":"A2","topic":"modal-verbs","estimated_minutes":12,"settings":{"display_mode":"one_at_a_time","feedback_timing":"question_end","show_score":true,"show_correct_answers":true,"show_explanations":true,"show_diagnostic_summary":true,"allow_retry":true},"sections":[{"client_key":"recovery_modal_verbs_practice_section","title":"Allenati","instructions":"Interpreta il significato prima di scegliere la struttura.","selection_mode":"fixed","feedback_timing":"question_end","questions":[{"client_key":"recovery_modals_practice_1","type":"dialogue_choice","title":"Preparare una gita","prompt":"What can Maya say?","instructions":"Leggi il dialogo e scegli la risposta più naturale.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"no_obligation","primary_skill":"interaction","learning_objective":"Use do not have to when something is unnecessary but not prohibited","difficulty":"standard","content":{"scenario":"Two students are reading the school trip information.","response_prompt":"What can Maya say?","turns":[{"key":"turn_1","speaker":"Maya","text":"Lunch is included in the price."},{"key":"turn_2","speaker":"Luca","text":"Great. I was going to make sandwiches."}],"options":[{"key":"a","text":"You don't have to bring lunch.","is_correct":true},{"key":"b","text":"You mustn't bring lunch.","is_correct":false,"error_code":"MODALS_OBLIGATION_PROHIBITION"},{"key":"c","text":"You should not to bring lunch.","is_correct":false,"error_code":"A2_MODALS_OBLIGATION_ADVICE"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Lunch è incluso: portarlo non è necessario, non vietato."},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_practice_2","type":"multiple_choice","title":"Una regola chiara","prompt":"Visitors ___ show a photo ID before entering the building. It is a security requirement.","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"external_obligation","primary_skill":"grammar","learning_objective":"Choose have to for a stated external requirement","difficulty":"standard","content":{"options":[{"key":"a","text":"have to","is_correct":true},{"key":"b","text":"should","is_correct":false,"error_code":"A2_MODALS_OBLIGATION_ADVICE"},{"key":"c","text":"don't have to","is_correct":false,"error_code":"MODALS_OBLIGATION_PROHIBITION"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Security requirement = have to."},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION","A2_MODALS_OBLIGATION_ADVICE"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_practice_3","type":"word_order","title":"Una domanda","prompt":"Forma la domanda corretta.","instructions":"Metti le parti nell'ordine corretto.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"can_question","primary_skill":"word_order","learning_objective":"Build a can question without do or to","difficulty":"standard","content":{"tokens":["Can","you","help","me","with this box"],"correct_order":["Can","you","help","me","with this box"],"terminal_punctuation":"?"},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Can va prima del soggetto."},"diagnostics":{"tested_codes":["A1_CAN_ABILITY_REQUESTS"],"fallback_error_code":"A1_CAN_ABILITY_REQUESTS"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_practice_4","type":"error_correction","title":"Una forma da correggere","prompt":"Correggi: My brother can to drive, but he doesn’t have a car.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"modal_base","primary_skill":"grammar","learning_objective":"Remove to after can while preserving the sentence meaning","difficulty":"standard","content":{"accepted_answers":["My brother can drive, but he doesn't have a car.","My brother can drive, but he does not have a car."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Can + drive, senza to."},"diagnostics":{"tested_codes":["A1_CAN_ABILITY_REQUESTS"],"fallback_error_code":"A1_CAN_ABILITY_REQUESTS"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_practice_5","type":"select_gap","title":"Regole di palestra","prompt":"Completa le regole.","instructions":"Completa scegliendo la forma corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"obligation_prohibition","primary_skill":"grammar","learning_objective":"Distinguish required action from prohibited action in rules","difficulty":"standard","content":{"text_template":"Members [[blank_1]] return weights after use. Children under 14 [[blank_2]] enter the weights area alone.","blanks":[{"key":"blank_1","accepted_answers":["have to"],"options":["have to","should to","don't have to"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"should to","error_code":"A2_MODALS_OBLIGATION_ADVICE"},{"answer":"don't have to","error_code":"MODALS_OBLIGATION_PROHIBITION"}]},{"key":"blank_2","accepted_answers":["mustn't","must not"],"options":["mustn't","don't have to","shouldn't to"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"don't have to","error_code":"MODALS_OBLIGATION_PROHIBITION"},{"answer":"shouldn't to","error_code":"A2_MODALS_OBLIGATION_ADVICE"}]}]},"grading":{"mode":"per_blank","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Prima frase = obbligo; seconda = divieto."},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION","A2_MODALS_OBLIGATION_ADVICE"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_practice_6","type":"translation","title":"Facoltativo","prompt":"Non devi portare un computer: puoi usare quelli della scuola.","instructions":"Traduci in inglese.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"integrated_no_obligation_can","primary_skill":"grammar","learning_objective":"Produce absence of obligation and can permission/availability in one context","difficulty":"standard","content":{"accepted_answers":["You don't have to bring a computer; you can use the school's computers.","You do not have to bring a computer; you can use the school computers.","You don't have to bring a laptop; you can use the school's computers.","You do not have to bring a laptop; you can use the school computers."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Don't have to = non è necessario; can = possibilità disponibile."},"diagnostics":{"tested_codes":["MODALS_OBLIGATION_PROHIBITION","A1_CAN_ABILITY_REQUESTS"],"fallback_error_code":"MODALS_OBLIGATION_PROHIBITION"},"tags":["recovery","modal-verbs"],"foundation_links":[]},{"client_key":"recovery_modals_practice_7","type":"multiple_choice","title":"Prima di un esame","prompt":"A friend has an exam tomorrow and has studied for six hours without a break. What is the best advice?","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A2","topic":"modal-verbs","subtopic":"advice","primary_skill":"grammar","learning_objective":"Choose should for non-compulsory advice from context","difficulty":"challenge","content":{"options":[{"key":"a","text":"You should take a short break.","is_correct":true},{"key":"b","text":"You must take a break because it is illegal not to.","is_correct":false,"error_code":"A