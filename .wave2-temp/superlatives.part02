anslation","title":"Dentro un gruppo","prompt":"Questo è il ristorante più economico della zona.","instructions":"Traduci in inglese.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"integrated","primary_skill":"grammar","learning_objective":"Produce a short-adjective superlative with a clear group reference","difficulty":"support","content":{"accepted_answers":["This is the cheapest restaurant in the area.","This is the cheapest restaurant in this area.","This is the cheapest restaurant around here."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Cheap → the cheapest; il gruppo è la zona."},"diagnostics":{"tested_codes":["SUPERLATIVE_EST","SUPERLATIVE_THE"],"fallback_error_code":"SUPERLATIVE_EST"},"tags":["recovery","superlatives"],"foundation_links":[]}],"question_refs":[],"pool_rules":[]}],"tags":["recovery","superlatives","recover","wave-2"],"foundation_links":[]},{"client_key":"recovery_superlatives_practice","title":"Superlatives — Allenati","description":"Pratica superlativi in scelte, sondaggi, viaggi e contesti scolastici.","instructions":"Usa il contesto del gruppo, non una tabella di forme.","instruction_language":"it","level":"A1+","topic":"superlatives","estimated_minutes":12,"settings":{"display_mode":"one_at_a_time","feedback_timing":"question_end","show_score":true,"show_correct_answers":true,"show_explanations":true,"show_diagnostic_summary":true,"allow_retry":true},"sections":[{"client_key":"recovery_superlatives_practice_section","title":"Allenati","instructions":"Usa il contesto del gruppo, non una tabella di forme.","selection_mode":"fixed","feedback_timing":"question_end","questions":[{"client_key":"recovery_sup_practice_1","type":"select_gap","title":"Una vacanza","prompt":"Una famiglia confronta tre hotel.","instructions":"Completa scegliendo la forma corretta.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"form_choice","primary_skill":"grammar","learning_objective":"Choose different superlative form families in one hotel context","difficulty":"standard","content":{"text_template":"Hotel A is quiet, Hotel B is near the beach, and Hotel C has large family rooms. Hotel C is [[blank_1]] option for a family of five, but Hotel A is [[blank_2]].","blanks":[{"key":"blank_1","accepted_answers":["the most comfortable"],"options":["the most comfortable","the comfortablest","most comfortable"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"the comfortablest","error_code":"SUPERLATIVE_MOST"},{"answer":"most comfortable","error_code":"SUPERLATIVE_THE"}]},{"key":"blank_2","accepted_answers":["the quietest"],"options":["the quietest","the most quiet","quietest"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"quietest","error_code":"SUPERLATIVE_THE"}]}]},"grading":{"mode":"per_blank","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Comfortable → the most comfortable; quiet → the quietest."},"diagnostics":{"tested_codes":["SUPERLATIVE_MOST","SUPERLATIVE_EST","SUPERLATIVE_THE"],"fallback_error_code":"SUPERLATIVE_MOST"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_2","type":"dialogue_choice","title":"Dove studiare?","prompt":"Which sentence best summarises Sara’s choice?","instructions":"Leggi il dialogo e scegli la risposta più naturale.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"irregular","primary_skill":"interaction","learning_objective":"Use the best to select one option from three based on context","difficulty":"standard","content":{"scenario":"Three classmates compare three study places.","response_prompt":"Which sentence best summarises Sara’s choice?","turns":[{"key":"turn_1","speaker":"Nina","text":"The library is silent but closes at six."},{"key":"turn_2","speaker":"Omar","text":"The café is open late but quite noisy."},{"key":"turn_3","speaker":"Sara","text":"The school study room is quiet and open until eight."}],"options":[{"key":"a","text":"For tonight, the school study room is the best option.","is_correct":true},{"key":"b","text":"For tonight, it is the more good option.","is_correct":false,"error_code":"SUPERLATIVE_IRREGULAR"},{"key":"c","text":"For tonight, it is best option.","is_correct":false,"error_code":"SUPERLATIVE_THE"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Tre opzioni: the best option."},"diagnostics":{"tested_codes":["SUPERLATIVE_IRREGULAR","SUPERLATIVE_THE"],"fallback_error_code":"SUPERLATIVE_IRREGULAR"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_3","type":"error_correction","title":"Una grafia","prompt":"Correggi: Monday was the busyest day of the week.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"spelling_y","primary_skill":"grammar","learning_objective":"Correct y-to-iest spelling in a group context","difficulty":"standard","content":{"accepted_answers":["Monday was the busiest day of the week."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Busy → busiest."},"diagnostics":{"tested_codes":["SUPERLATIVE_Y_IEST"],"fallback_error_code":"SUPERLATIVE_Y_IEST"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_4","type":"word_order","title":"Forma la frase","prompt":"Metti in ordine.","instructions":"Metti le parti nell'ordine corretto.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"long_adjectives","primary_skill":"word_order","learning_objective":"Build a the most + adjective superlative phrase with group reference","difficulty":"standard","content":{"tokens":["This","is","the most useful","app","on my phone"],"correct_order":["This","is","the most useful","app","on my phone"],"terminal_punctuation":"."},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Useful usa the most."},"diagnostics":{"tested_codes":["SUPERLATIVE_MOST","SUPERLATIVE_THE"],"fallback_error_code":"SUPERLATIVE_MOST"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_5","type":"multiple_choice","title":"Una settimana difficile","prompt":"I had five exams this month. Yesterday’s maths exam was ___.","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"irregular","primary_skill":"grammar","learning_objective":"Use the worst as the superlative of bad","difficulty":"standard","content":{"options":[{"key":"a","text":"the worst","is_correct":true},{"key":"b","text":"the baddest","is_correct":false,"error_code":"SUPERLATIVE_IRREGULAR"},{"key":"c","text":"the more bad","is_correct":false,"error_code":"SUPERLATIVE_IRREGULAR"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Bad → the worst."},"diagnostics":{"tested_codes":["SUPERLATIVE_IRREGULAR"],"fallback_error_code":"SUPERLATIVE_IRREGULAR"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_6","type":"translation","title":"Un luogo della città","prompt":"È il museo più interessante della città.","instructions":"Traduci in inglese.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"long_adjectives","primary_skill":"grammar","learning_objective":"Produce the most with a longer adjective and a group phrase","difficulty":"standard","content":{"accepted_answers":["It is the most interesting museum in the city.","It's the most interesting museum in the city."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Interesting → the most interesting."},"diagnostics":{"tested_codes":["SUPERLATIVE_MOST","SUPERLATIVE_THE"],"fallback_error_code":"SUPERLATIVE_MOST"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_7","type":"select_gap","title":"Un sondaggio di classe","prompt":"Completa i risultati.","instructions":"Completa scegliendo la forma corretta.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"integrated","primary_skill":"grammar","learning_objective":"Interpret numerical group information and choose long and CVC superlatives","difficulty":"challenge","content":{"text_template":"In our class survey, cycling got 18 votes, swimming 11 and running 6. Cycling is [[blank_1]] activity. The cycling club also has 42 members, so it is [[blank_2]] club at school.","blanks":[{"key":"blank_1","accepted_answers":["the most popular"],"options":["the most popular","the popularest","most popular"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"the popularest","error_code":"SUPERLATIVE_MOST"},{"answer":"most popular","error_code":"SUPERLATIVE_THE"}]},{"key":"blank_2","accepted_answers":["the biggest"],"options":["the biggest","the bigest","biggest"],"points":1,"feedback":{},"answer_error_mappings":[{"answer":"the bigest","error_code":"SUPERLATIVE_DOUBLE_CONSONANT"},{"answer":"biggest","error_code":"SUPERLATIVE_THE"}]}]},"grading":{"mode":"per_blank","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Popular → the most popular; big → the biggest."},"diagnostics":{"tested_codes":["SUPERLATIVE_MOST","SUPERLATIVE_DOUBLE_CONSONANT","SUPERLATIVE_THE"],"fallback_error_code":"SUPERLATIVE_MOST"},"tags":["recovery","superlatives"],"foundation_links":[]},{"client_key":"recovery_sup_practice_8","type":"error_correction","title":"Una forma doppia","prompt":"Correggi: This is the most easiest part of the project.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A1+","topic":"superlatives","subtopic":"double_superlative","primary_skill":"grammar","learning_obje