ers":["My little brother is happier at his new school."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Con consonante + y: happy → happier."},"diagnostics":{"tested_codes":["COMPARATIVE_Y_IER"],"fallback_error_code":"COMPARATIVE_Y_IER"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_practice_5","type":"multiple_choice","title":"Un viaggio meno piacevole","prompt":"Yesterday the traffic was bad. Today there are roadworks and the journey is even ___.","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"irregular","primary_skill":"grammar","learning_objective":"Choose worse as the comparative of bad in a natural travel context","difficulty":"standard","content":{"options":[{"key":"a","text":"worse","is_correct":true},{"key":"b","text":"badder","is_correct":false,"error_code":"COMPARATIVE_IRREGULAR"},{"key":"c","text":"more bad","is_correct":false,"error_code":"COMPARATIVE_IRREGULAR"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{"explanation":"Bad → worse."},"diagnostics":{"tested_codes":["COMPARATIVE_IRREGULAR"],"fallback_error_code":"COMPARATIVE_IRREGULAR"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_practice_6","type":"translation","title":"Confronta le lezioni","prompt":"La lezione di oggi è più interessante di quella di ieri.","instructions":"Traduci in inglese.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"long_adjectives","primary_skill":"grammar","learning_objective":"Produce more + adjective + than with a natural omitted noun","difficulty":"standard","content":{"accepted_answers":["Today's lesson is more interesting than yesterday's.","The lesson today is more interesting than yesterday's lesson.","Today's class is more interesting than yesterday's."]},"grading":{"mode":"automatic"