["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_verify_5","type":"dialogue_choice","title":"Una decisione","prompt":"Which comparison best explains why they choose the café?","instructions":"Leggi il dialogo e scegli la risposta più naturale.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"meaning","primary_skill":"interaction","learning_objective":"Infer a meaningful comparison from a connected dialogue","difficulty":"standard","content":{"scenario":"Maya and Luca are deciding where to study.","response_prompt":"Which comparison best explains why they choose the café?","turns":[{"key":"turn_1","speaker":"Maya","text":"The library is quiet, but it closes at six."},{"key":"turn_2","speaker":"Luca","text":"The study café is open until ten, but drinks are expensive."},{"key":"turn_3","speaker":"Maya","text":"We need at least three hours tonight."}],"options":[{"key":"a","text":"The café is more convenient than the library for tonight.","is_correct":true},{"key":"b","text":"The café is convenienter then the library for tonight.","is_correct":false,"error_code":"COMPARATIVE_MORE"},{"key":"c","text":"The café is the most convenient than the library.","is_correct":false,"error_code":"COMPARATIVE_MORE"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["COMPARATIVE_MORE","COMPARATIVE_THAN"],"fallback_error_code":"COMPARATIVE_MORE"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_verify_6","type":"word_order","title":"Confronto completo","prompt":"Forma la frase.","instructions":"Metti le parti nell'ordine corretto.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"irregular","primary_skill":"word_order","learning_objective":"Build an irregular comparative clause with than","difficulty":"standard","content":{"tokens":["My second exam","was","worse","than","the first one"],"correct_order":["My second exam","was","worse","than","the first one"],"terminal_punctuation":"."},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["COMPARATIVE_IRREGULAR","COMPARATIVE_THAN"],"fallback_error_code":"COMPARATIVE_IRREGULAR"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_verify_7","type":"multiple_choice","title":"Un cambiamento","prompt":"Last month the bus ticket was €1.50. Now it is €2.00. The ticket is ___ now.","instructions":"Scegli la risposta corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"long_adjectives","primary_skill":"grammar","learning_objective":"Choose more with a longer adjective from price information","difficulty":"challenge","content":{"options":[{"key":"a","text":"more expensive","is_correct":true},{"key":"b","text":"expensiver","is_correct":false,"error_code":"COMPARATIVE_MORE"},{"key":"c","text":"more expensiver","is_correct":false,"error_code":"COMPARATIVE_MORE"}]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["COMPARATIVE_MORE"],"fallback_error_code":"COMPARATIVE_MORE"},"tags":["recovery","comparatives"],"foundation_links":[]},{"client_key":"recovery_comp_verify_8","type":"error_correction","title":"Controlla lo spelling","prompt":"Correggi: Nina seems happyer in her new class than in the old one.","instructions":"Riscrivi la frase corretta.","instruction_language":"it","level":"A1+","topic":"comparatives","subtopic":"spelling_y","primary_skill":"grammar","learning_objective":"Correct y-to-ier spelling within a full comparison","difficulty":"challenge","content":{"accepted_answers":["Nina seems happier in her new class than in the old one."]},"grading":{"mode":"automatic","weight":1,"nearly_correct_multiplier":0.5},"feedback":{},"diagnostics":{"tested_codes":["COMPARATIVE_Y_IER","COMPARATIVE_THAN"],"fallback_error