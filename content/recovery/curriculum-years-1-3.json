{
  "schema_version": 1,
  "curriculum_id": "recovery-years-1-3-v1",
  "scope": "Recupero Debito English for Italian secondary-school years 1-3",
  "school_programme_is_authoritative": true,
  "principles": [
    "The student's official school recovery programme decides which topics are required.",
    "Do not expose a topic as ready in the learner product until all required recovery phases have publishable content.",
    "Teach for school success and usable English at the same time: examples must sound natural, while Modalità scuola must reproduce realistic Italian-school task formats.",
    "Avoid mechanical Cambridge-style repetition when the same grammar can be practised through realistic routines, school life, messages, plans, short dialogues and mini-texts.",
    "Prioritise high-probability Italian learner errors only when they genuinely apply to the target structure.",
    "A topic is not mastered because a learner recognises the rule in multiple choice; production, question formation, negatives and form choice must be tested when relevant.",
    "Do not mix a later grammar point into an earlier topic merely to make examples look harder.",
    "Every graded item must have one defensible answer or a complete accepted-answer set. No trick questions."
  ],
  "phase_contract": {
    "recover": {
      "purpose": "Rebuild the rule and immediately connect it to successful use.",
      "target_minutes": "10-12",
      "requirements": [
        "structured educational content block",
        "concrete examples before unnecessary terminology",
        "4-6 scaffolded checks",
        "immediate explanatory feedback",
        "at least one likely Italian-learner error when relevant"
      ]
    },
    "practice": {
      "purpose": "Make the learner retrieve and manipulate the target without relying on the explanation.",
      "target_minutes": "10-14",
      "requirements": [
        "8-12 meaningful items",
        "at least three exercise formats when the grammar allows it",
        "mix affirmative, negative and interrogative forms when relevant",
        "natural contexts and varied subjects",
        "diagnostic error codes for the specific misconception being tested"
      ]
    },
    "school": {
      "purpose": "Transfer the grammar to formats commonly seen in Italian school recovery tests.",
      "target_minutes": "8-12",
      "requirements": [
        "no teaching block or rule label that reveals the answer",
        "exercise-end feedback rather than coaching during the task",
        "use realistic formats such as gap fill, transformations, error correction, translation, word order, short text completion or mixed choice",
        "instructions may be Italian, but target language remains English",
        "difficulty comes from retrieval and format, not obscure vocabulary"
      ]
    },
    "verify": {
      "purpose": "Measure whether the learner can now handle the topic independently.",
      "target_minutes": "6-10",
      "requirements": [
        "6-10 balanced graded items",
        "no teaching content",
        "coverage of every must-master subskill",
        "exercise-end feedback",
        "recommended mastery threshold 80 percent"
      ]
    }
  },
  "content_waves": [
